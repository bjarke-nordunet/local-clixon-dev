# Local settings: what cannot be derived from the checkout. Copy to .env and
# edit. docker compose reads this file too (compose.yml is beside it), as do
# the shell scripts and harness/*.py, so there is one place to set anything.
#
#   cp .env.example .env

# The clixon controller to obtain things from (device YANG, the controller's
# own YANG, per-device module revisions, running config), as ssh takes it.
# A Host alias from ~/.ssh/config is the better place for user, port and
# IdentityFile. The ssh user must be able to open the backend socket.
CLIXON_HOST_SSH=controller.example.org

# Devices to mount YANG for, as comma-separated shell patterns. Only these
# have their device config validated. Each costs memory (around 2GB per
# distinct module set), so start with one or two. Empty primes only the first
# device in the datastore. Add more at runtime with:
#   docker exec clixon-dev prime-device.sh 'router-*'
#PRIME_DEVICES=router1,router2

# The snc-services checkout. Default: checkouts/snc-services. It is
# bind-mounted rather than built into the image, so it may live anywhere.
#SNC_SERVICES=/path/to/snc-services

# Change these to run alongside another local controller.
#CONTAINER_NAME=clixon-dev
#BACKEND_PORT=4535
#DEBUGPY_PORT=5678
