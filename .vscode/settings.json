{
    // The service packages are not an installable Python package: on a
    // controller, install.sh flattens each packages/<pkg>/ into one modules
    // dir and the pyapi puts both that dir and each package dir on sys.path.
    // Pylance has to mirror that to resolve "from filter import bgpq4" and
    // "from lib import create_peer" the way the controller does.
    //
    // The list below and the PYTHONPATH in services.env are generated by
    //     venv/bin/python harness/sync_paths.py
    // from the same function the local pyapi uses. Re-run it
    // after adding a package or changing SNC_SERVICES.

    "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",

    // Generated by harness/sync_paths.py -- do not hand-edit.
    "python.analysis.extraPaths": [
        "${workspaceFolder}/harness",
        "${workspaceFolder}/checkouts/clixon-pyapi",
        "${workspaceFolder}/checkouts/snc-services/packages",
        "${workspaceFolder}/checkouts/snc-services/packages/bgp/cli",
        "${workspaceFolder}/checkouts/snc-services/packages/bgp",
        "${workspaceFolder}/checkouts/snc-services/packages/customer",
        "${workspaceFolder}/checkouts/snc-services/packages/filter",
        "${workspaceFolder}/checkouts/snc-services/packages/ibgp_core",
        "${workspaceFolder}/checkouts/snc-services/packages/ipclos",
        "${workspaceFolder}/checkouts/snc-services/packages/l2c/cli",
        "${workspaceFolder}/checkouts/snc-services/packages/l2c",
        "${workspaceFolder}/checkouts/snc-services/packages/ssh_users",
        "${workspaceFolder}/checkouts/snc-services/packages/test",
        "${workspaceFolder}/checkouts/snc-services/packages/utils",
        "${workspaceFolder}/checkouts/snc-services/packages/vrf"
    ],
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.exclude": [
        "**/venv/**",
        "**/__pycache__/**"
    ],

    // What running and debugging use. Same list, same generator.
    "python.envFile": "${workspaceFolder}/.vscode/services.env",

    // The checkouts are their own repos; show them in Source Control.
    "git.scanRepositories": [
        "checkouts/clixon",
        "checkouts/clixon-controller",
        "checkouts/clixon-pyapi",
        "checkouts/snc-services"
    ],

    // checkouts/ and fetched/ are gitignored here, and search honours
    // .gitignore by default, which would hide the pyapi source -- and text
    // search is how you get from a hook to its dynamic call site in
    // clixon/modules.py. Decide what is skipped here instead.
    "search.useIgnoreFiles": false,
    "search.useParentIgnoreFiles": false,
    "search.useGlobalIgnoreFiles": false,
    "search.exclude": {
        "**/venv/**": true,
        "**/__pycache__/**": true,
        "**/.git/**": true,
        "fetched/mounts/**": true
    }
}
